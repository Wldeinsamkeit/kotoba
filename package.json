{
  "name": "nihongo-daily",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:clean": "vite --host 127.0.0.1 --port 5174 --force --strictPort",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "seo:sitemap": "node scripts/generate-sitemap.cjs",
    "vocab:n1": "node scripts/build_n2_vocab_from_pdfs.cjs n1",
    "vocab:n2": "node scripts/build_n2_vocab_from_pdfs.cjs n2",
    "memory:writing-scope": "node scripts/build_writing_scope_relations.cjs",
    "memory:merge-n5": "node scripts/merge_memory_batches.cjs --level n5 --through 17",
    "memory:merge-n4": "node scripts/merge_memory_batches.cjs --level n4 --through 30",
    "word-links:build": "node scripts/build_n5_n4_link_map_public.cjs",
    "memory:sample": "node scripts/sample_memory_methods.cjs",
    "memory:sample-all": "node scripts/sample_memory_methods.cjs --level all --count 20",
    "lesson:check": "node scripts/lesson_check_48.cjs",
    "lesson:unlock-all": "node scripts/unlock_all_lessons.cjs",
    "lesson:vocab-dupes": "node scripts/check_lesson_vocab_dupes.cjs",
    "ios:sync": "npm run build && cap sync ios",
    "ios:open": "cap open ios"
  },
  "dependencies": {
    "@capacitor/core": "^8.3.4",
    "@capacitor/ios": "^8.3.4",
    "@supabase/supabase-js": "^2.106.2",
    "onnxruntime-web": "^1.26.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.3.4",
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1"
  }
}
